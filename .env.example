# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser commitado (está no .gitignore).

APP_NAME=Oficina API
APP_VERSION=0.1.0

# Ambiente de execução: development (padrao) ou production.
# Em production a aplicacao NAO sobe com o JWT_SECRET no valor padrao.
APP_ENV=development

# Banco de dados (SQLite por padrão)
DATABASE_URL=sqlite:///./oficina.db

# Autenticação JWT
# Em producao, troque por um valor secreto longo e aleatorio (a aplicacao
# recusa subir com o valor padrao abaixo quando APP_ENV=production).
JWT_SECRET=troque-por-um-valor-secreto-bem-grande
JWT_ALGORITMO=HS256
JWT_EXPIRA_MIN=60

# Usuário administrativo semeado no primeiro boot.
# A senha e guardada apenas como hash (bcrypt); o valor abaixo nunca e
# persistido em texto puro.
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
