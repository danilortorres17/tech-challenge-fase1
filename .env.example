# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser commitado (está no .gitignore).

APP_NAME=Oficina API
APP_VERSION=0.1.0

# Banco de dados (SQLite por padrão)
DATABASE_URL=sqlite:///./oficina.db

# Autenticação JWT
JWT_SECRET=troque-por-um-valor-secreto-bem-grande
JWT_ALGORITMO=HS256
JWT_EXPIRA_MIN=60

# Usuário administrativo de demonstração
ADMIN_USUARIO=admin
ADMIN_SENHA=admin123
